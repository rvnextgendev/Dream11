# Copy this file to `.env` and fill in your key.
# Get a FREE Groq API key: https://console.groq.com/keys  (keys start with gsk_)
GROQ_API_KEY="your_groq_api_key_here"

# Optional — override the model (default: openai/gpt-oss-120b).
# For a faster/lighter run: GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — tracing (Session 3). Free account at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=dream11-genie
